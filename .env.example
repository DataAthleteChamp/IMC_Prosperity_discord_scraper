# =============================================================================
# discord-channel-scraper — secrets & environment
# Copy to `.env` and fill in values. NEVER commit `.env`.
#
# Only credentials and global defaults live here. *What* to scrape (servers,
# channels, output paths) belongs in `scraper.toml` — see scraper.example.toml.
# =============================================================================

# --- User-token auth (ToS-risk: violates Discord ToS, ban risk on your account)
# Obtain via: Discord web → DevTools → Network → any authenticated request →
# copy the `Authorization` header value. Treat as equivalent to your password.
DISCORD_USER_TOKEN=

# --- Bot-token auth (ToS-clean, requires a server admin to invite the bot)
# Create an application at https://discord.com/developers/applications,
# enable Message Content Intent, copy bot token.
DISCORD_BOT_TOKEN=

# --- Optional: a second account, referenced from scraper.toml via
#     token_env = "DISCORD_USER_TOKEN_ALT"
# DISCORD_USER_TOKEN_ALT=

# --- Optional: path to the targets config (default: ./scraper.toml)
# SCRAPER_CONFIG=/absolute/path/to/scraper.toml

# --- Optional: only used by ad-hoc runs that pass neither --target nor --all
# DISCORD_GUILD_ID=
# SCRAPER_OUTPUT_DIR=./data

# Stealth rate limit: average requests per second (default 5, keep <=10)
SCRAPER_RATE_LIMIT=5
